# Shared frontend + backend configuration.

# Frontend (Vite build-time variables)
VITE_API_URL=https://api.example.com
VITE_GEOAPIFY_API_KEY=replace_with_geoapify_key

# Backend
TOURIN_ENV=production
TOURIN_PORT=5000
TOURIN_GRAPHML_PATH=/app/assets/ilocos_norte_osmnx.graphml
TOURIN_CORS_ALLOWED_ORIGIN=https://app.example.com

# Reverse proxy / Traefik
TOURIN_TRAEFIK_DYNAMIC_ENV=prod
TOURIN_TRAEFIK_METRICS_PORT=8082
TOURIN_TRAEFIK_DASHBOARD_BIND=127.0.0.1:8080

# Keep this list aligned with Cloudflare's published IP ranges.
TOURIN_CLOUDFLARE_TRUSTED_IPS=173.245.48.0/20,103.21.244.0/22
